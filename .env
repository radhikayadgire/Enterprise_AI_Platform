SECRET_KEY=dev-secret-key-change-me
ALGORITHM=HS256

# IMS-4: SESSION_TIMEOUT_MINUTES is in MINUTES. Previously a code path built
# the token expiry with timedelta(seconds=SESSION_TIMEOUT_MINUTES), which
# turned this same "10" into a 10-second-lived token on mobile.
SESSION_TIMEOUT_MINUTES=30
REFRESH_TOKEN_TIMEOUT_DAYS=7

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@enterprise-ai-platform.local
