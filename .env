# Local development defaults. Override these in your deployment environment.
JWT_SECRET_KEY=dev-secret-key-change-me
JWT_REFRESH_SECRET_KEY=dev-refresh-secret-key-change-me

# Access tokens are short-lived; mobile/web clients silently exchange a
# refresh token for a new access token instead of forcing a re-login.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=sqlite:///./backend/app.db
BACKEND_URL=http://localhost:8000
